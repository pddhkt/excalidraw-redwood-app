{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "excalidraw-redwood-app",
  "account_id": "9abdd4944b6a8642bc5a9667524cceaa",
  "main": "src/worker.tsx",
  "compatibility_date": "2025-08-21",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SESSION_DURABLE_OBJECT",
        "class_name": "SessionDurableObject"
      }
    ]
  },
  "vars": {
    "WEBAUTHN_APP_NAME": "Excalidraw Redwood App",
    "WEBAUTHN_RP_ID": "excalidraw-redwood-app.pages.dev",
    "AUTH_SECRET_KEY": "your-secret-key-change-this-in-production-1234567890abcdef"
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SessionDurableObject"]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "excalidraw-redwood-app-db",
      "database_id": "d9fc960d-070e-46cd-915a-8cdcbc97d9e2"
    }
  ]
}
