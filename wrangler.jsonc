{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "excalidraw-redwood-app",
  "account_id": "9abdd4944b6a8642bc5a9667524cceaa",
  "main": "src/worker.tsx",
  "compatibility_date": "2025-08-21",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SESSION_DURABLE_OBJECT",
        "class_name": "SessionDurableObject"
      }
    ]
  },
  "vars": {
    "WEBAUTHN_APP_NAME": "Excalidraw Redwood App",
    "WEBAUTHN_RP_ID": "excalidraw-redwood-app.pages.dev"
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SessionDurableObject"]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "excalidraw-app-db",
      "database_id": "12345678-1234-5678-9abc-123456789def"
    }
  ]
}
